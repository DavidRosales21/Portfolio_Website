---
/**
 * Contact form — name, email, message only (content/03-home.md §8). Delivered by Netlify Forms on Netlify,
 * by Formspree on any other host (site.ts → hosting / forms); views only render it when `formsOn`.
 * Honeypot blocks spam bots. States (busy / success / error, typed text kept) come from scripts/form.ts.
 */
import { site } from '../config/site';
import { routes, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const netlify = site.hosting === 'netlify';
const honeypot = netlify ? 'company_website' : '_gotcha';
---
<form
  id="contact"
  name="contact"
  method="POST"
  action={netlify ? routes.thanks[lang] : site.forms.formspree}
  data-netlify={netlify ? 'true' : undefined}
  netlify-honeypot={netlify ? honeypot : undefined}
  data-ajax
  data-sending={ui.formSending}
  data-success={ui.formSuccess}
  data-error={ui.formError}
  class="stack"
>
  <input type="hidden" name="form-name" value="contact" />
  <input type="hidden" name="lang" value={lang} />
  {!netlify && <input type="hidden" name="_subject" value="Portfolio — new message" />}
  <p class="visually-hidden" aria-hidden="true">
    <label>{ui.honeypot} <input name={honeypot} tabindex="-1" autocomplete="off" /></label>
  </p>

  <div class="field">
    <label for="cf-name">{ui.formName}</label>
    <input id="cf-name" name="name" type="text" autocomplete="name" required />
  </div>
  <div class="field">
    <label for="cf-email">{ui.formEmail}</label>
    <input id="cf-email" name="email" type="email" autocomplete="email" required />
  </div>
  <div class="field">
    <label for="cf-message">{ui.formMessage}</label>
    <textarea id="cf-message" name="message" rows="6" required></textarea>
  </div>

  <div class="form-status" role="status" aria-live="polite" tabindex="-1"></div>
  <div><button class="btn btn--primary" type="submit">{ui.formSend}</button></div>
</form>

<script>
  import '../scripts/form';
</script>
