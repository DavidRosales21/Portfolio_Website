---
/** Accessible FAQ using native <details>. Pair with <Schema faq={...}/> on the page. */
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((f) => (
    <details>
      <summary>{f.q}</summary>
      <div><p>{f.a}</p></div>
    </details>
  ))}
</div>
