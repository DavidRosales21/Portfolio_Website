---
/**
 * Privacy policy + short terms — content/12-legal.md. v1 published WITHOUT analytics (David, 2026-10-22);
 * a lawyer in Ontario reviews it before GA4/Clarity are turned on. Rows and providers follow site.ts
 * (hosting, forms, analytics), so the page never describes a tool the site doesn't use.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, emailHref, formsOn, analyticsOn } from '../config/site';
import { routes, type Lang } from '../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const email = site.person.email;
const host = site.hosting === 'netlify' ? 'Netlify (Netlify, Inc.)' : 'GitHub Pages (GitHub, Inc.)';
const formsBy = site.hosting === 'netlify' ? 'Netlify Forms' : 'Formspree';
const c = {
  en: {
    title: 'Privacy Policy — David Rosales, Software Developer Portfolio',
    description: 'How David Rosales’s portfolio handles your data: what the contact form, emails and recommendations collect, how long it’s kept and how to have it deleted.',
    h1: 'Privacy policy',
    updated: 'Last updated: October 22, 2026',
    who: ['Who I am', `This is the personal portfolio website of David Rosales, a student in Ontario, Canada. Contact: ${email}.`],
    collectH2: 'What I collect and why',
    rows: [
      ['Name, email, message', formsOn ? 'You use the contact form or email me' : 'You email me', 'To reply to you', '12 months after our last message, then deleted'],
      ['Name, role, organization, email, answers, publishing permissions', 'You write a recommendation', 'To read it and, only with your permission, publish part of it with your name and role', 'While it’s published, or until you ask me to remove it'],
      ...(analyticsOn ? [['Pages visited, approximate location, device, browser, how you arrived', 'Only if you accept analytics cookies', 'To understand which pages help visitors and improve the site', '[TODO: GA4 retention setting]']] : []),
      [analyticsOn ? 'Your choices (cookie consent, light/dark mode, language notice)' : 'Your choices (light/dark mode, language notice)', 'Always, on your device only', 'So the site remembers them', 'Until you clear your browser data'],
    ],
    head: ['Data', 'When', 'Why', 'Kept for'],
    analyticsH2: analyticsOn ? 'Analytics (only with your consent)' : 'Analytics',
    noAnalytics: 'This site doesn’t use analytics, advertising or tracking cookies. If that changes, I’ll update this policy first, and nothing will be stored without your consent.',
    analytics: [
      'Google Analytics 4 (Google LLC): visits and actions like downloading my résumé or sending a message. GA4 doesn’t store IP addresses.',
      'Microsoft Clarity (Microsoft Corp.): heatmaps and anonymized session recordings. Every form field is masked, so what you type is never recorded.',
      'I use Google Consent Mode v2: nothing is stored until you choose “Accept”. “Decline” is just as easy, and you can change your choice anytime from “Cookie settings” in the footer.',
    ],
    providersH2: 'Service providers',
    providers: `The website is hosted by ${host}, which, like any web host, processes visitors’ IP addresses to deliver the pages and keep them secure. ${formsOn ? `Form submissions are processed by ${formsBy}, and messages` : 'Messages'} reach my inbox through Gmail (Google). These providers may process data outside Canada (for example, in the United States). I don’t sell or rent your data, and I don’t share it except with these providers, to make the site work.`,
    rightsH2: 'Your rights',
    rights: 'You can ask to see, correct or delete your data, or to remove a published recommendation. Email me and I’ll answer within 30 days. If you’re in the EU/UK, you also have the GDPR rights to object, restrict processing and file a complaint with your data-protection authority. In Canada, you can contact the Office of the Privacy Commissioner of Canada.',
    termsH2: 'Terms of use',
    terms: [
      'The text, images and design of this site belong to David Rosales unless noted otherwise. studIA Notes and its screenshots belong to their owner (David Rosales).',
      'The site is provided as is; I try to keep it accurate and up to date.',
      'Links to other sites (LinkedIn, GitHub, studianotes.com, Google Play) are for convenience. I’m not responsible for their content.',
      'These terms are governed by the laws of Ontario and of Canada.',
    ],
    changes: 'If this policy changes, I’ll update the date above.',
  },
  es: {
    title: 'Política de privacidad — Portafolio de David Rosales',
    description: 'Cómo trata tus datos el portafolio de David Rosales: qué recogen el formulario, los emails y las recomendaciones, cuánto tiempo se guarda y cómo pedir que se borre.',
    h1: 'Política de privacidad',
    updated: 'Última actualización: 22 de octubre de 2026',
    who: ['Quién soy', `Esta es la web personal (portafolio) de David Rosales, estudiante en Ontario, Canadá. Contacto: ${email}.`],
    collectH2: 'Qué recojo y para qué',
    rows: [
      ['Nombre, email, mensaje', formsOn ? 'Usas el formulario de contacto o me escribes un email' : 'Me escribes un email', 'Para responderte', '12 meses después de nuestro último mensaje; luego se borra'],
      ['Nombre, rol, organización, email, respuestas, permisos de publicación', 'Escribes una recomendación', 'Para leerla y, solo con tu permiso, publicar una parte con tu nombre y tu rol', 'Mientras esté publicada, o hasta que me pidas quitarla'],
      ...(analyticsOn ? [['Páginas visitadas, ubicación aproximada, dispositivo, navegador, cómo llegaste', 'Solo si aceptas las cookies de análisis', 'Para entender qué páginas ayudan a los visitantes y mejorar la web', '[TODO: retención configurada en GA4]']] : []),
      [analyticsOn ? 'Tus elecciones (consentimiento de cookies, modo claro/oscuro, aviso de idioma)' : 'Tus elecciones (modo claro/oscuro, aviso de idioma)', 'Siempre, solo en tu dispositivo', 'Para que la web las recuerde', 'Hasta que borres los datos del navegador'],
    ],
    head: ['Dato', 'Cuándo', 'Para qué', 'Se guarda'],
    analyticsH2: analyticsOn ? 'Analítica (solo con tu consentimiento)' : 'Analítica',
    noAnalytics: 'Esta web no usa analítica, publicidad ni cookies de seguimiento. Si eso cambia, primero actualizaré esta política, y no se guardará nada sin tu consentimiento.',
    analytics: [
      'Google Analytics 4 (Google LLC): visitas y acciones como descargar mi CV o enviar un mensaje. GA4 no guarda direcciones IP.',
      'Microsoft Clarity (Microsoft Corp.): mapas de calor y grabaciones anónimas de sesiones. Todos los campos de los formularios están ocultos, así que lo que escribes nunca se graba.',
      'Uso Google Consent Mode v2: no se guarda nada hasta que eliges «Aceptar». «Rechazar» es igual de fácil, y puedes cambiar tu elección cuando quieras desde «Configurar cookies» en el pie de página.',
    ],
    providersH2: 'Proveedores',
    providers: `La web está alojada en ${host}, que, como cualquier alojamiento web, trata las direcciones IP de los visitantes para servir las páginas y mantenerlas seguras. ${formsOn ? `Los formularios los procesa ${formsBy}, y los mensajes` : 'Los mensajes'} llegan a mi bandeja a través de Gmail (Google). Estos proveedores pueden tratar datos fuera de Canadá (por ejemplo, en Estados Unidos). No vendo ni alquilo tus datos, y no los comparto salvo con estos proveedores, para que la web funcione.`,
    rightsH2: 'Tus derechos',
    rights: 'Puedes pedir ver, corregir o borrar tus datos, o retirar una recomendación publicada. Escríbeme y te respondo en 30 días como máximo. Si estás en la UE o el Reino Unido, también tienes los derechos del RGPD a oponerte, limitar el tratamiento y reclamar ante tu autoridad de protección de datos. En Canadá puedes contactar con la Office of the Privacy Commissioner of Canada.',
    termsH2: 'Términos de uso',
    terms: [
      'Los textos, imágenes y el diseño de esta web pertenecen a David Rosales, salvo que se indique lo contrario. studIA Notes y sus capturas pertenecen a su propietario (David Rosales).',
      'La web se ofrece tal cual; intento mantenerla correcta y actualizada.',
      'Los enlaces a otros sitios (LinkedIn, GitHub, studianotes.com, Google Play) son por comodidad. No soy responsable de su contenido.',
      'Estos términos se rigen por las leyes de Ontario y de Canadá.',
    ],
    changes: 'Si esta política cambia, actualizaré la fecha de arriba.',
  },
}[lang];
---
<BaseLayout lang={lang} title={c.title} description={c.description} alternates={routes.privacy}>
  <section class="section">
    <div class="container container--narrow stack prose">
      <h1>{c.h1}</h1>
      <p class="note">{c.updated}</p>
      <h2>{c.who[0]}</h2>
      <p>{c.who[1]}</p>
      <h2>{c.collectH2}</h2>
      <div class="table-wrap">
        <table>
          <thead><tr>{c.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{c.rows.map((r) => <tr>{r.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}</tr>)}</tbody>
        </table>
      </div>
      <h2>{c.analyticsH2}</h2>
      {analyticsOn ? <ul class="list">{c.analytics.map((a) => <li>{a}</li>)}</ul> : <p>{c.noAnalytics}</p>}
      <h2>{c.providersH2}</h2>
      <p>{c.providers}</p>
      <h2>{c.rightsH2}</h2>
      <p>{c.rights} <a href={emailHref}>{email}</a></p>
      <h2>{c.termsH2}</h2>
      <ul class="list">{c.terms.map((x) => <li>{x}</li>)}</ul>
      <p class="note">{c.changes}</p>
    </div>
  </section>
</BaseLayout>
